{
  "manifest_version": 3,
  "name": "Alaturka Yeni Sekme",
  "version": "0.4.0",
  "description": "Her yeni sekmede alaturka saat, namaz vakitleri ve hicri takvim.",
  "default_locale": "tr",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "system.cpu",
    "system.memory",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}